# Example environment variables for the CMS (do NOT commit real secrets)
# Copy this file to `.env` in the `cms/` folder for local development and fill in values.

# Database
# DATABASE_CLIENT can be 'sqlite' (default), 'mysql' or 'postgres'
DATABASE_CLIENT=sqlite

# For sqlite (local dev):
DATABASE_FILENAME=.tmp/data.db

# For mysql / postgres (production):
# DATABASE_HOST=your-db-host
# DATABASE_PORT=5432
# DATABASE_NAME=colocal_db
# DATABASE_USERNAME=colocal_user
# DATABASE_PASSWORD=super-secure-password
# Or provide a full connection string (postgres):
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# SSL options (optional)
# DATABASE_SSL=false
# DATABASE_SSL_KEY=
# DATABASE_SSL_CERT=
# DATABASE_SSL_CA=

# Other useful settings
# DATABASE_SCHEMA=public
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# Do not commit a real .env file containing secrets to version control.HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# Required: change these in your local copy
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Default database (sqlite)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
