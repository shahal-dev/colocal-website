{
  "kind": "collectionType",
  "collectionName": "education_trainings",
  "info": {
    "singularName": "education-training",
    "pluralName": "education-trainings",
    "displayName": "Education/Training"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "secondary_title": {
      "type": "string"
    },
    "date": {
      "type": "date",
      "required": true
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "type": {
      "type": "component",
      "component": "shared.education",
      "repeatable": false
    },
    "lla": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "project": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project",
      "inversedBy": "education_trainings"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "section": {
      "type": "enumeration",
      "enum": [
        "module development",
        "short course",
        "training workshop"
      ]
    }
  }
}
