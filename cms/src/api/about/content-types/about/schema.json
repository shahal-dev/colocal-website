{
  "kind": "singleType",
  "collectionName": "abouts",
  "info": {
    "singularName": "about",
    "pluralName": "abouts",
    "displayName": "About",
    "description": "Write about yourself and the content you create"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "subtitle": {
      "type": "string",
      "required": true
    },
    "about": {
      "type": "text",
      "required": true
    },
    "mission": {
      "type": "text",
      "required": true
    },
    "objectives": {
      "type": "component",
      "component": "shared.objective",
      "repeatable": true,
      "required": true
    },
    "quotes": {
      "type": "component",
      "component": "shared.quote",
      "repeatable": true
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "media": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    }
  }
}
