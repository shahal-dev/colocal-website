{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "shortTitle": {
      "type": "string",
      "required": true
    },
    "longTitle": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "about": {
      "type": "richtext",
      "required": true
    },
    "shortDescription": {
      "type": "text",
      "required": true
    },
    "longDescription": {
      "type": "richtext",
      "required": true
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "objectives": {
      "type": "component",
      "component": "shared.objective",
      "repeatable": true
    },
    "research_publications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::research-publication.research-publication",
      "mappedBy": "project"
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "programme": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "news_events": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::news-event.news-event",
      "mappedBy": "projects"
    },
    "education_trainings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::education-training.education-training",
      "mappedBy": "project"
    }
  }
}
