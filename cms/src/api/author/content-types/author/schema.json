{
  "kind": "collectionType",
  "collectionName": "authors",
  "info": {
    "singularName": "author",
    "pluralName": "authors",
    "displayName": "Author",
    "description": "Create authors for your content"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "email": {
      "type": "string"
    },
    "colocal": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "team": {
      "type": "boolean",
      "default": false
    },
    "title": {
      "type": "string"
    },
    "titles": {
      "type": "component",
      "repeatable": true,
      "component": "shared.designation"
    },
    "admin": {
      "type": "boolean",
      "default": false
    },
    "country": {
      "type": "enumeration",
      "enum": [
        "norway",
        "bangladesh",
        "mozambique",
        "nepal",
        "uganda"
      ]
    },
    "news_event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::news-event.news-event",
      "inversedBy": "authors"
    }
  }
}
