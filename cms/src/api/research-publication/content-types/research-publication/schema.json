{
  "kind": "collectionType",
  "collectionName": "research_publications",
  "info": {
    "singularName": "research-publication",
    "pluralName": "research-publications",
    "displayName": "Research/Publication"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "secondary_title": {
      "type": "string"
    },
    "abstract": {
      "type": "richtext",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "URL": {
      "type": "string",
      "required": true
    },
    "authors_text": {
      "type": "text"
    },
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "tags": {
      "type": "component",
      "component": "shared.tag",
      "repeatable": true
    },
    "project": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project",
      "inversedBy": "research_publications"
    },
    "publication_type": {
      "type": "component",
      "component": "shared.publication-type",
      "repeatable": false,
      "required": true
    },
    "theme": {
      "type": "component",
      "component": "shared.theme",
      "repeatable": false
    },
    "country": {
      "type": "component",
      "component": "shared.country",
      "repeatable": false
    },
    "image_cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
