# Strapi (Postgres) - Staging/Production
HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# Generate fresh values before use
APP_KEYS=replace_key1,replace_key2,replace_key3,replace_key4
JWT_SECRET=replace_jwt_secret
ADMIN_JWT_SECRET=replace_admin_jwt_secret
API_TOKEN_SALT=replace_api_token_salt
TRANSFER_TOKEN_SALT=replace_transfer_token_salt
ENCRYPTION_KEY=replace_encryption_key

# Database (Postgres)
DATABASE_CLIENT=postgres
# Option A: discrete settings
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=colocal_db
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false
# Option B: single URL (preferred for managed DBs)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_SSL=true